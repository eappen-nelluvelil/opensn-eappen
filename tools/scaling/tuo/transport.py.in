"""Tuolumne device-CBCD scaling input generated by study.py."""

n_g = 64
n_polar = 14
n_azimuthal = 32

meshgen = DistributedMeshGenerator(
    inputs=[FromFileMeshGenerator(filename=@MESH@)]
)
grid = meshgen.Execute()
grid.SetOrthogonalBoundaries()

xs_diag = MultiGroupXS()
xs_diag.LoadFromOpenSn(@XS@)

boundary_source = [0.0 for _ in range(n_g)]
boundary_source[0] = 1.0

quadrature = GLCProductQuadrature3DXYZ(
    n_polar=n_polar,
    n_azimuthal=n_azimuthal,
    scattering_order=0,
)

problem = DiscreteOrdinatesProblem(
    mesh=grid,
    num_groups=n_g,
    sweep_type="CBC",
    use_gpus=True,
    groupsets=[
        {
            "groups_from_to": (0, n_g - 1),
            "angular_quadrature": quadrature,
            "angle_aggregation_type": "single",
            "inner_linear_method": "petsc_richardson",
            "l_abs_tol": 1.0e-12,
            "l_max_its": @MAX_ITERATIONS@,
        }
    ],
    xs_map=[{"block_ids": [1], "xs": xs_diag}],
    boundary_conditions=[
        {"name": "xmin", "type": "isotropic", "group_strength": boundary_source}
    ],
    options={
        "max_mpi_message_size": 256 * 1024,
        "save_angular_flux": @SAVE_ANGULAR_FLUX@,
    },
)

solver = SteadyStateSourceSolver(problem=problem)
solver.Initialize()
solver.Execute()

# A residual/iteration signature alone cannot detect every flux-lifecycle error.
# Compute two inexpensive, global scalar-flux observables after the solve and
# print enough digits to round-trip a binary64 value through study.py.
scalar_fluxes = problem.GetScalarFluxFieldFunction(only_scalar_flux=False)
whole_domain = RPPLogicalVolume(infx=True, infy=True, infz=True)
for group in (0, n_g - 1):
    interpolator = FieldFunctionInterpolationVolume()
    interpolator.SetOperationType("max")
    interpolator.SetLogicalVolume(whole_domain)
    interpolator.AddFieldFunction(scalar_fluxes[group][0])
    interpolator.Execute()
    maximum = interpolator.GetValue()
    if rank == 0:
        print(
            "OPENSN_TUO_SCALAR_FLUX_MAX "
            f"group={group} value={maximum:.17e}"
        )
